# API service
HYDROWISE_ENV=development

# Weather provider adapter (leave blank for mock)
WEATHER_API_BASE_URL=
WEATHER_API_KEY=

# Persistence and device authentication
DATABASE_URL=sqlite:///hydrowise.db
DEVICE_API_KEY=hydrowise-esp32-key-dev
DEVICE_INGESTION_SECRET=hydrowise-esp32-key-dev
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","*"]

# Model artifact location/version
MODEL_ARTIFACT_PATH=
MODEL_VERSION=mock-v0.1

